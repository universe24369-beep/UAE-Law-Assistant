{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Represents a client of a lawyer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "lawyerId": { "type": "string" }
      },
      "required": ["id", "name", "lawyerId"]
    },
    "Case": {
      "title": "Case",
      "description": "Represents a case for a client.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "clientId": { "type": "string" },
        "lawyerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "closed"] }
      },
      "required": ["id", "title", "clientId", "lawyerId", "createdAt", "status"]
    },
    "User": {
      "title": "User",
      "description": "Represents a user of the platform (Client or Lawyer).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "lawyer"] },
        "bio": { "type": "string" },
        "specialization": { "type": "string" },
        "pricePerHour": { "type": "number" },
        "avatarUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "A scheduled consultation between a client and a lawyer.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "lawyerId": { "type": "string" },
        "lawyerName": { "type": "string" },
        "price": { "type": "number" },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "meetingType": { "type": "string", "enum": ["video", "in-person"] },
        "meetingLink": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "await_confirmation", "confirmed", "completed", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientId", "lawyerId", "status", "scheduledAt", "createdAt"]
    },
    "AIConversation": {
      "title": "AI Conversation",
      "description": "Stored interactions with the AI legal advisor.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "type": "object" }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "Legislation": {
      "title": "Legislation",
      "description": "Stored UAE law articles for fast RAG retrieval.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "content": { "type": "string" },
        "articleNumber": { "type": "string" },
        "lawNumber": { "type": "string" },
        "year": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "sourceUrl": { "type": "string" }
      },
      "required": ["title", "content", "lawNumber"]
    },
    "LawyerApplication": {
      "title": "Lawyer Application",
      "description": "Application from a lawyer to join the platform.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "specializations": { "type": "array", "items": { "type": "string" } },
        "experience": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "bio": { "type": "string" },
        "education": { "type": "string" },
        "languages": { "type": "string" },
        "price": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "userPhoto": { "type": "string" },
        "workingHours": {
          "type": "object",
          "properties": {
            "weekday": { "type": "object", "properties": { "start": { "type": "string" }, "end": { "type": "string" } } },
            "friday": { "type": "object", "properties": { "start": { "type": "string" }, "end": { "type": "string" } } }
          }
        },
        "offDays": { "type": "array", "items": { "type": "string" } },
        "isOOO": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName", "email", "status", "createdAt"]
    },
    "LawyerCoPilotSession": {
      "title": "Lawyer Co-Pilot Session",
      "description": "Technical AI advisor sessions for professional lawyers.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "messages": {
          "type": "array",
          "items": { "type": "object" }
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isTechnical": { "type": "boolean" },
        "caseId": { "type": "string" }
      },
      "required": ["userId", "messages", "updatedAt"]
    },
    "LawyerProfile": {
      "title": "Lawyer Profile",
      "description": "Public profile for lawyers on the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "specialization": { "type": "string" },
        "bio": { "type": "string" },
        "price": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "Precedent": {
      "title": "Precedent",
      "description": "UAE legal precedents and case law summaries.",
      "type": "object",
      "properties": {
        "caseName": { "type": "string" },
        "citation": { "type": "string" },
        "court": { "type": "string" },
        "year": { "type": "string" },
        "legalPrinciples": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "jurisdiction": { "type": "string", "enum": ["Dubai", "Abu Dhabi", "Federal", "DIFC", "ADGM"] }
      },
      "required": ["caseName", "citation", "summary", "jurisdiction"]
    }
  },
  "firestore": {
    "clients/{clientId}": {
      "schema": "Client",
      "description": "Clients of the lawyer."
    },
    "cases/{caseId}": {
      "schema": "Case",
      "description": "Cases for clients."
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles for clients and lawyers."
    },
    "consultations/{consultationId}": {
      "schema": "Consultation",
      "description": "System for booking and managing legal consultations."
    },
    "ai_conversations/{conversationId}": {
      "schema": "AIConversation",
      "description": "History of AI legal discussions."
    },
    "lawyers/{lawyerId}": {
      "schema": "LawyerProfile",
      "description": "Public profile for lawyers on the platform."
    },
    "legislation/{lawId}": {
      "schema": "Legislation",
      "description": "Cache of UAE laws for fast RAG processing."
    },
    "lawyer_applications/{applicationId}": {
      "schema": "LawyerApplication",
      "description": "Applications from lawyers to join the platform."
    },
    "lawyer_co_pilots/{sessionId}": {
      "schema": "LawyerCoPilotSession",
      "description": "Deep-legal research and drafting co-pilot data."
    },
    "precedents/{precedentId}": {
      "schema": "Precedent",
      "description": "Library of court rulings and legal precedents."
    },
    "authorized_lawyers/{email}": {
      "schema": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "addedAt": { "type": "string", "format": "date-time" },
          "addedBy": { "type": "string" }
        },
        "required": ["email", "addedAt"]
      },
      "description": "White-list of emails authorized to use lawyer features."
    },
    "support_sessions/{sessionId}": {
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "userEmail": { "type": "string" },
          "userRole": { "type": "string", "enum": ["client", "lawyer"] },
          "messages": { "type": "array" },
          "status": { "type": "string", "enum": ["active", "resolved"] },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "userRole", "messages", "updatedAt"]
      },
      "description": "Customer support interactions with AI and admin visibility."
    },
    "support_incidents/{incidentId}": {
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "userEmail": { "type": ["string", "null"] },
          "userRole": { "type": "string", "enum": ["client", "lawyer"] },
          "route": { "type": "string" },
          "pageTitle": { "type": "string" },
          "source": { "type": "string", "enum": ["support_mcp"] },
          "category": { "type": "string", "enum": ["login", "account", "upload", "navigation", "performance", "payment", "bug", "other"] },
          "severity": { "type": "string", "enum": ["low", "medium", "high"] },
          "status": { "type": "string", "enum": ["new", "needs_screenshot", "triaged", "resolved"] },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "userMessage": { "type": "string" },
          "testScenarios": { "type": "array" },
          "screenshot": {
            "type": ["object", "null"],
            "properties": {
              "fileName": { "type": "string" },
              "mimeType": { "type": "string" },
              "fileSize": { "type": "number" },
              "previewDataUrl": { "type": ["string", "null"] }
            }
          },
          "manualConfirmationRequired": { "type": "boolean" },
          "publicationGate": { "type": "string", "enum": ["chat_confirmation"] },
          "adminRecipients": { "type": "array" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "userRole", "route", "pageTitle", "source", "category", "severity", "status", "title", "summary", "userMessage", "testScenarios", "manualConfirmationRequired", "publicationGate", "adminRecipients", "createdAt", "updatedAt"]
      },
      "description": "Bug-only support incidents with test scenarios and manual chat confirmation gate."
    },
    "admins/{userId}": {
      "schema": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "role": { "type": "string", "enum": ["super", "manager"] },
          "addedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "role", "addedAt"]
      },
      "description": "Platform administrators with elevated permissions."
    },
    "usage_stats/{statId}": {
      "schema": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["openrouter_query", "legal_search", "document_generation", "support_query"] },
          "userId": { "type": "string" },
          "tokens": { "type": "number" },
          "totalTokens": { "type": "number" },
          "inputTokens": { "type": "number" },
          "outputTokens": { "type": "number" },
          "model": { "type": ["string", "null"] },
          "utilizationPct": { "type": ["number", "null"] },
          "usageStage": { "type": ["string", "null"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["success", "error"] }
        },
        "required": ["type", "timestamp", "status"]
      },
      "description": "System-wide API and tool usage metrics."
    }
  }
}
