rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // PHASE 3: GLOBAL HELPERS
    // ==========================================
    
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "universe.24.369@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // COLLECTION: USERS
    // ==========================================
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['client', 'lawyer'] &&
             (data.bio == null || (data.bio is string && data.bio.size() <= 2000)) &&
             (data.specialization == null || (data.specialization is string && data.specialization.size() <= 500)) &&
             data.keys().hasAll(['uid', 'email', 'role']);
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'specialization', 'pricePerHour', 'avatarUrl'])
      )) || isAdmin();
    }

    // ==========================================
    // COLLECTION: LAWYER APPLICATIONS
    // ==========================================
    function isValidLawyerApp(data) {
      return data.userId == request.auth.uid &&
             data.fullName is string && data.fullName.size() <= 200 &&
             data.status == 'pending' &&
             data.createdAt == request.time &&
             data.keys().hasAll(['userId', 'fullName', 'status', 'createdAt']);
    }

    match /lawyer_applications/{appId} {
      allow read: if isOwner(existing().userId) || isAdmin();
      allow create: if isEmailVerified() && isValidLawyerApp(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // COLLECTION: LAWYERS (Public Profiles)
    // ==========================================
    function isValidLawyer(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.specialization is string && data.specialization.size() <= 200 &&
             data.price is number;
    }

    match /lawyers/{lawyerId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() || (isOwner(lawyerId) && isValidLawyer(incoming()));
      allow update: if isAdmin() || (
        isOwner(lawyerId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['workingHours', 'offDays', 'isOOO', 'updatedAt', 'name', 'specialization', 'price', 'bio']) &&
        incoming().updatedAt == request.time
      );
    }

    // ==========================================
    // COLLECTION: CLIENTS
    // ==========================================
    function isValidClient(data) {
      return data.lawyerId == request.auth.uid &&
             data.name is string && data.name.size() <= 100 &&
             (data.email == null || (data.email is string && data.email.size() <= 200)) &&
             data.keys().hasAll(['lawyerId', 'name']);
    }

    match /clients/{clientId} {
      allow read: if isSignedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidClient(incoming());
      allow update: if isSignedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin()) && isValidClient(incoming());
      allow delete: if isSignedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // COLLECTION: CASES
    // ==========================================
    function isValidCase(data) {
      return data.lawyerId == request.auth.uid &&
             data.clientId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.status in ['active', 'closed'] &&
             data.createdAt is string &&
             data.keys().hasAll(['lawyerId', 'clientId', 'title', 'status', 'createdAt']);
    }

    match /cases/{caseId} {
      allow read: if isSignedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidCase(incoming());
      allow update: if isSignedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin()) && isValidCase(incoming());
      allow delete: if isSignedIn() && (resource.data.lawyerId == request.auth.uid || isAdmin());
    }

    // ==========================================
    // COLLECTION: CONSULTATIONS
    // ==========================================
    function isValidConsultation(data) {
      return data.clientId == request.auth.uid &&
             data.lawyerId is string &&
             data.lawyerName is string &&
             data.price is string &&
             data.scheduledAt is string &&
             (data.meetingType == 'video' || data.meetingType == 'in-person') &&
             (data.meetingLink == null || data.meetingLink is string) &&
             data.status == 'pending' &&
             data.paymentStatus == 'paid' &&
             data.createdAt == request.time &&
             data.keys().hasAll(['clientId', 'lawyerId', 'lawyerName', 'price', 'scheduledAt', 'meetingType', 'meetingLink', 'status', 'paymentStatus', 'createdAt']) &&
             data.keys().size() == 10;
    }

    match /consultations/{consultationId} {
      allow get: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.lawyerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.lawyerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isEmailVerified() && isValidConsultation(incoming());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (resource.data.clientId == request.auth.uid || resource.data.lawyerId == request.auth.uid) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'meetingLink', 'meetingType', 'scheduledAt'])
        )
      );
    }

    // ==========================================
    // COLLECTION: SUPPORT SESSIONS
    // ==========================================
    function isValidSupportSession(data) {
      return data.userId == request.auth.uid &&
             data.userRole in ['client', 'lawyer'] &&
             data.messages is list &&
             data.updatedAt == request.time;
    }

    match /support_sessions/{sessionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidSupportSession(incoming());
      allow update: if (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'updatedAt']) && incoming().updatedAt == request.time) || isAdmin();
    }

    // ==========================================
    // COLLECTION: SUPPORT INCIDENTS
    // ==========================================
    function isValidSupportIncident(data) {
      return data.userId == request.auth.uid &&
             data.userRole in ['client', 'lawyer'] &&
             data.source == 'support_mcp' &&
             data.route is string &&
             data.pageTitle is string &&
             data.category in ['login', 'account', 'upload', 'navigation', 'performance', 'payment', 'bug', 'other'] &&
             data.severity in ['low', 'medium', 'high'] &&
             data.status in ['new', 'needs_screenshot', 'triaged', 'resolved'] &&
             data.title is string &&
             data.summary is string &&
             data.userMessage is string &&
             data.testScenarios is list &&
             data.manualConfirmationRequired == true &&
             data.publicationGate == 'chat_confirmation';
    }

    match /support_incidents/{incidentId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidSupportIncident(incoming());
      allow update: if isAdmin() || (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ==========================================
    // COLLECTION: AI CONVERSATIONS
    // ==========================================
    match /ai_conversations/{convId} {
      allow read: if isOwner(existing().userId);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'updatedAt']) && incoming().updatedAt == request.time;
      allow delete: if isOwner(existing().userId);
    }

    // ==========================================
    // COLLECTION: LEGISLATION
    // ==========================================
    match /legislation/{lawId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // COLLECTION: ADMINS
    // ==========================================
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable via Firebase Console or special script
    }
    
    // ==========================================
    // COLLECTION: AUTHORIZED LAWYERS
    // ==========================================
    match /authorized_lawyers/{email} {
      allow get: if isSignedIn() && email == request.auth.token.email;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ==========================================
    // COLLECTION: USAGE STATS
    // ==========================================
    function isValidUsageStat(data) {
      return data.type in ['openrouter_query', 'legal_search', 'document_generation', 'support_query'] &&
             data.status in ['success', 'error'] &&
             data.timestamp == request.time &&
             (data.userId == request.auth.uid || data.userId == 'anonymous');
    }

    match /usage_stats/{statId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidUsageStat(incoming());
      allow update, delete: if false;
    }

    // ==========================================
    // COLLECTION: LAWYER CO-PILOTS
    // ==========================================
    match /lawyer_co_pilots/{sessionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if (isOwner(existing().userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'updatedAt']) && 
                      incoming().updatedAt == request.time) || isAdmin();
      allow delete: if isOwner(existing().userId) || isAdmin();
    }
  }
}
